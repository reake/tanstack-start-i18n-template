# Optional shell/CI variables for deployment and sitemap generation.
# Local development does not require an environment file.

# Optional sitemap override. When omitted, the value from src/site.config.ts is used.
# SITE_URL=https://your-domain.com

# These scripts do not read VITE_BASE_URL. Canonical URLs and SEO metadata come from
# `url` in src/site.config.ts instead.

# Deployment target used by `pnpm run deploy`: pages (default) or workers.
CF_DEPLOY_TARGET=pages

# Required for Pages deployments unless configured in your shell/CI already.
CF_PAGES_PROJECT_NAME=your-pages-project
