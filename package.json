{
  "name": "tanstack-start-i18n-template",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.20.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "pnpm sitemap:generate && vite build",
    "deploy": "node scripts/deploy.mjs",
    "deploy:pages": "node scripts/deploy.mjs pages",
    "deploy:workers": "node scripts/deploy.mjs workers",
    "sitemap:generate": "node scripts/generate-sitemap.mjs",
    "licenses:generate": "node scripts/licenses.mjs",
    "assets:generate": "node scripts/generate-assets.mjs",
    "preflight": "node scripts/preflight.mjs",
    "preflight:skip": "PREFLIGHT_SKIP=1 pnpm build",
    "locale-links:check": "node scripts/check-locale-links.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "tsc --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm check-types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deps": "pnpm dlx taze@latest -Ilw",
    "ui": "pnpm dlx shadcn@latest"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@content-collections/core": "^0.13.0",
    "@content-collections/mdx": "^0.2.2",
    "@content-collections/vite": "^0.2.8",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.1",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "nitro": "3.0.260903-beta",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.4.0",
    "vite": "^8.0.0-beta.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^2.3.13",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/eslint-plugin-query": "^5.104.2",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^26.1.0",
    "oxc-transform-react": "^0.154.0",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.0.16",
    "wrangler": "^4.55.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
